---
import data from '../data/tickets.json';
import site from '../data/site.json';
const emph = data.headline_emphasis;
const parts = emph && data.headline.includes(emph) ? data.headline.split(emph) : [data.headline];
---
<section id="tickets" class="tickets">
  <div class="container tickets__inner">
    <header class="tickets__head">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="display tickets__title">
        {parts.length > 1 ? (
          <>{parts[0]}<br/><span class="editorial">{emph}</span>{parts.slice(1).join(emph)}</>
        ) : data.headline}
      </h2>
      <p class="tickets__sub">{data.description}</p>
    </header>

    <div class="tiers">
      {data.tiers.map((t) => (
        <article class={`tier${t.featured ? ' tier--featured' : ''}`}>
          {t.featured && <span class="tier__badge mono">Most wanted</span>}
          <header class="tier__head">
            <span class="mono tier__note">{t.note}</span>
            <h3 class="display tier__name">{t.name}</h3>
            <p class="display tier__price">{t.price}</p>
          </header>
          <ul class="tier__perks">
            {t.perks.map((p) => (
              <li>
                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                  <path d="M3 8 L7 12 L13 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a href={t.cta_href || site.purplepass_url} target="_blank" rel="noopener" class={`btn ${t.featured ? 'btn--acid' : 'btn--ghost'} tier__cta`}>
            {t.cta} →
          </a>
        </article>
      ))}
    </div>

    <p class="tickets__fine mono">{data.fine_print}</p>
  </div>
</section>

<style>
  .tickets {
    background: var(--ink);
    color: var(--bone);
    position: relative;
  }
  .tickets__inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }

  .tickets__head {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
  }
  .tickets__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.9;
  }
  .tickets__title .editorial {
    font-style: italic;
    color: var(--neon);
  }
  .tickets__sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--lavender);
    max-width: 56ch;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
  }

  .tier {
    position: relative;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.5rem;
    background: var(--ink);
    border-right: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
    transition: background .35s var(--ease);
  }
  .tier:last-child { border-right: 0; }
  .tier:hover { background: var(--ink-soft); }

  .tier--featured {
    background: color-mix(in oklab, var(--neon) 10%, var(--ink));
  }
  .tier--featured:hover {
    background: color-mix(in oklab, var(--neon) 16%, var(--ink));
  }

  .tier__badge {
    position: absolute;
    top: -1px; right: -1px;
    padding: 0.35rem 0.75rem;
    background: var(--neon);
    color: var(--ink);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
  }

  .tier__head { display: grid; gap: 0.35rem; }
  .tier__note { color: var(--lavender); font-size: 0.68rem; }
  .tier__name {
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .tier__price {
    font-size: clamp(2.6rem, 5vw, 4rem);
    line-height: 0.9;
    color: var(--bone);
    margin-top: 0.25rem;
  }
  .tier--featured .tier__price { color: var(--neon); }

  .tier__perks {
    display: grid;
    gap: 0.6rem;
    color: color-mix(in oklab, var(--bone) 82%, transparent);
    font-size: 0.95rem;
  }
  .tier__perks li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    line-height: 1.45;
  }
  .tier__perks svg { color: var(--neon); margin-top: 0.3em; }

  .tier__cta { justify-self: start; }

  .tickets__fine {
    text-align: center;
    color: var(--lavender);
  }

  /* Tablet: 4 tiles get too narrow side-by-side, so wrap to 2x2. */
  @media (max-width: 1200px) and (min-width: 901px) {
    .tiers { grid-template-columns: repeat(2, 1fr); }
    .tier:nth-child(2) { border-right: 0; }
    .tier:nth-child(1),
    .tier:nth-child(2) {
      border-bottom: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
    }
  }

  @media (max-width: 900px) {
    .tiers { grid-template-columns: 1fr; }
    .tier {
      border-right: 0;
      border-bottom: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
    }
    .tier:last-child { border-bottom: 0; }
  }

  @media (max-width: 560px) {
    .tickets__sub { font-size: 0.95rem; }
    .tier { padding: 1.5rem 1.25rem; gap: 1.15rem; }
    .tier__name { font-size: 1.25rem; }
    .tier__price { font-size: 2.2rem; }
    .tier__perks { font-size: 0.88rem; gap: 0.45rem; }
    .tier__badge { font-size: 0.55rem; letter-spacing: 0.16em; padding: 0.3rem 0.6rem; }
    .tier__cta { width: 100%; justify-content: center; justify-self: stretch; }
    .tickets__fine { font-size: 0.6rem; letter-spacing: 0.12em; line-height: 1.5; }
  }
</style>
