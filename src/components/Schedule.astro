---
import data from '../data/schedule.json';
const emph = data.headline_emphasis;
const headlineParts = emph && data.headline.includes(emph) ? data.headline.split(emph) : [data.headline];
---
<section id="schedule" class="schedule">
  <div class="container schedule__inner">
    <header class="schedule__head">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="display schedule__title">
        {headlineParts.length > 1 ? (
          <>{headlineParts[0]}<br/><span class="editorial">{emph}</span>{headlineParts.slice(1).join(emph)}</>
        ) : data.headline}
      </h2>
      <p class="schedule__lead">{data.description}</p>
    </header>

    <div class="stages">
      {data.stages.map((stage) => (
        <div class={`stage stage--${stage.id}`}>
          <header class="stage__head">
            <span class="stage__dot" aria-hidden="true"></span>
            <h3 class="display stage__name">{stage.name}</h3>
            <span class="mono stage__count">{stage.slots.length} sets</span>
          </header>
          <ol class="stage__list">
            {stage.slots.map((slot) => (
              <li class="slot">
                <span class="mono slot__time">{slot.time}</span>
                <span class="slot__band display">{slot.band}</span>
                {slot.note && <span class="mono slot__note">{slot.note}</span>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <p class="schedule__fine mono">{data.fine_print}</p>
  </div>
</section>

<style>
  .schedule {
    background: var(--ink);
    color: var(--bone);
  }
  .schedule__inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .schedule__head { display: grid; gap: 1rem; max-width: 62rem; }
  .schedule__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.9;
  }
  .schedule__title .editorial {
    color: var(--neon);
    font-style: italic;
  }
  .schedule__lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--lavender);
    max-width: 56ch;
  }
  .schedule__lead strong { color: var(--bone); font-weight: 500; }

  .stages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
  }
  .stage {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-right: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .stage:last-child { border-right: 0; }

  .stage__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
  }
  .stage__dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--bone);
  }
  .stage--nile .stage__dot        { background: var(--neon); }
  .stage--underground .stage__dot { background: var(--lavender); }
  .stage--coffee .stage__dot      { background: var(--rust); }

  .stage__name {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    letter-spacing: 0.02em;
  }
  .stage__count {
    color: var(--lavender);
    font-size: 0.62rem;
  }

  .stage__list {
    display: grid;
    gap: 1rem;
    counter-reset: slot;
  }
  .slot {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--bone) 10%, transparent);
  }
  .slot:last-child { border-bottom: 0; }
  .slot__time {
    color: var(--lavender);
    font-size: 0.72rem;
  }
  .slot__band {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.2;
    color: var(--bone);
    letter-spacing: 0.01em;
  }
  .stage--nile .slot__band:hover         { color: var(--neon); }
  .stage--underground .slot__band:hover  { color: var(--lavender); }
  .stage--coffee .slot__band:hover       { color: var(--rust); }
  .slot__note {
    color: var(--lavender);
    font-size: 0.62rem;
  }

  .schedule__fine {
    text-align: center;
    color: var(--lavender);
  }

  @media (max-width: 900px) {
    .stages { grid-template-columns: 1fr; }
    .stage {
      border-right: 0;
      border-bottom: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
    }
    .stage:last-child { border-bottom: 0; }
  }

  @media (max-width: 560px) {
    .schedule__lead { font-size: 0.95rem; }
    .stage { padding: 1.25rem 1rem; gap: 1rem; }
    .stage__head {
      padding-bottom: 0.75rem;
      gap: 0.5rem;
    }
    .stage__name { font-size: 1.25rem; }
    .stage__count { font-size: 0.58rem; letter-spacing: 0.14em; }
    .stage__list { gap: 0.7rem; }
    .slot {
      padding-bottom: 0.7rem;
      gap: 0.2rem;
    }
    .slot__band { font-size: 0.88rem; line-height: 1.25; letter-spacing: 0; }
    .slot__time { font-size: 0.65rem; letter-spacing: 0.1em; }
    .slot__note { font-size: 0.58rem; letter-spacing: 0.14em; }
    .schedule__fine { font-size: 0.6rem; letter-spacing: 0.12em; line-height: 1.5; }
  }
</style>
