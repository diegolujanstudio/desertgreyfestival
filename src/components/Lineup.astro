---
import data from '../data/lineup.json';

// Support legacy keys (headliners/main/support) and new keys (tier_1..tier_4).
const tier1 = data.tier_1 || data.headliners || [];
const tier2 = data.tier_2 || data.main || [];
const tier3 = data.tier_3 || data.support || [];
const tier4 = data.tier_4 || [];

// Each band entry can be either a plain string OR an object { name, instagram }.
// Normalize so we can render uniformly.
const norm = (b) => (typeof b === 'string') ? { name: b, instagram: '' } : { name: b?.name ?? '', instagram: b?.instagram ?? '' };

const tiers = [
  { items: tier1.map(norm), mod: '1' },
  { items: tier2.map(norm), mod: '2' },
  { items: tier3.map(norm), mod: '3' },
  { items: tier4.map(norm), mod: '4' },
].filter(t => t.items && t.items.length > 0);
---
<section id="lineup" class="lineup grain-soft">
  <div class="container">
    <header class="lineup__head">
      <span class="eyebrow">{data.eyebrow}</span>
    </header>

    {tiers.map((t, idx) => (
      <>
        {idx > 0 && <div class="rule lineup__rule"></div>}
        <div class={`lineup__tier lineup__tier--${t.mod}`}>
          {t.mod === '4' ? (
            t.items.map((b, i) => (
              <>
                {i > 0 && <span class="lineup__sep" aria-hidden="true">·</span>}
                {b.instagram ? (
                  <a href={b.instagram} target="_blank" rel="noopener noreferrer" class={`lineup__band lineup__band--4`}>{b.name}</a>
                ) : (
                  <span class={`lineup__band lineup__band--4`}>{b.name}</span>
                )}
              </>
            ))
          ) : (
            t.items.map((b) => (
              b.instagram ? (
                <a href={b.instagram} target="_blank" rel="noopener noreferrer" class={`lineup__band lineup__band--${t.mod}`}>{b.name}</a>
              ) : (
                <span class={`lineup__band lineup__band--${t.mod}`}>{b.name}</span>
              )
            ))
          )}
        </div>
      </>
    ))}

    <footer class="lineup__foot">
      <p class="mono">{data.rollout_note}</p>
      {data.cta_text && <a href={data.cta_href} class="btn btn--acid">{data.cta_text}</a>}
    </footer>
  </div>
</section>

<style>
  .lineup {
    background: var(--ink);
    color: var(--bone);
    position: relative;
  }
  .lineup__head {
    max-width: 64rem;
    margin: 0 auto 4rem;
    text-align: center;
    display: grid; gap: 1rem; justify-items: center;
  }

  .lineup__tier {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    text-align: center;
    padding: clamp(1rem, 2.5vh, 2rem) 0;
  }

  .lineup__band {
    font-family: var(--f-display);
    text-transform: uppercase;
    display: inline-block;
    text-decoration: none;
    transition: color .25s var(--ease), transform .25s var(--ease);
    cursor: pointer;
  }
  /* Plain spans get default cursor; only the <a> tags should look interactive. */
  span.lineup__band { cursor: default; }
  .lineup__band:hover { color: var(--neon); }
  a.lineup__band:hover { transform: translateY(-2px); }

  /* TIER 1 — Headliners. Big text, natural widths, single uniform color.
     Lets multi-word names wrap with neighbours instead of stretching across a row. */
  .lineup__tier--1 {
    gap: 0.35rem clamp(1.5rem, 3.5vw, 3rem);
    max-width: 88rem;
    margin: 0 auto;
  }
  .lineup__band--1 {
    font-size: clamp(1.7rem, 4.4vw, 4rem);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--bone);
    padding: 0 0.1em;
  }

  /* TIER 2 — Featured. Fixed 4-per-row so 7 names lay out as 4 + 3 (orphan row auto-centers via justify-content). */
  .lineup__tier--2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    text-align: center;
    gap: 0.5rem clamp(1rem, 2.4vw, 2rem);
    max-width: 88rem;
    margin: 0 auto;
  }
  .lineup__band--2 {
    flex: 0 0 calc(25% - clamp(1rem, 2.4vw, 2rem));
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    line-height: 1.04;
    color: var(--bone);
  }

  /* TIER 3 — Mid-bill */
  .lineup__tier--3 {
    gap: 0.4rem clamp(1rem, 1.9vw, 1.6rem);
    max-width: 72rem;
    margin: 0 auto;
  }
  .lineup__band--3 {
    font-size: clamp(0.95rem, 1.6vw, 1.4rem);
    line-height: 1.05;
    color: color-mix(in oklab, var(--bone) 88%, transparent);
  }

  /* TIER 4 — Also appearing */
  .lineup__tier--4 {
    gap: 0.45rem 0.7rem;
    max-width: 56rem;
    margin: 0 auto;
  }
  .lineup__band--4 {
    font-family: var(--f-mono);
    font-size: clamp(0.7rem, 1vw, 0.88rem);
    letter-spacing: 0.12em;
    color: var(--lavender);
    text-transform: uppercase;
  }
  .lineup__sep {
    color: color-mix(in oklab, var(--lavender) 55%, transparent);
    font-family: var(--f-mono);
    font-size: 0.85rem;
    user-select: none;
  }

  .lineup__rule { margin: 1.75rem auto; max-width: 80%; opacity: 0.15; }

  .lineup__foot {
    margin-top: 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--bone) 14%, transparent);
  }
  .lineup__foot .mono { color: var(--lavender); }

  /* Tablet: tier 2 wraps to 2-per-row so names breathe on iPad-sized screens. */
  @media (max-width: 900px) and (min-width: 561px) {
    .lineup__band--2 {
      flex: 0 0 calc(50% - clamp(0.75rem, 2vw, 1.5rem));
      font-size: clamp(1.05rem, 2.6vw, 1.6rem);
    }
  }

  @media (max-width: 560px) {
    .lineup__head { margin-bottom: 2.5rem; }
    .lineup__tier { padding: 1rem 0; }
    .lineup__band--1 { font-size: clamp(1.4rem, 8.5vw, 2.4rem); }
    .lineup__band--2 {
      font-size: clamp(1.05rem, 4.5vw, 1.5rem);
      flex: 0 0 calc(50% - 0.75rem); /* 2 per row on small screens */
    }
    .lineup__band--3 { font-size: clamp(0.9rem, 3.6vw, 1.15rem); }
    .lineup__band--4 { font-size: 0.66rem; letter-spacing: 0.1em; }
    .lineup__sep { font-size: 0.75rem; }
    .lineup__rule { margin: 1.25rem auto; }
    .lineup__foot {
      margin-top: 2.5rem;
      justify-content: center;
      text-align: center;
    }
    .lineup__foot .mono { flex: 1 1 100%; }
    .lineup__foot .btn { width: 100%; justify-content: center; }
  }

  /* Phone-narrow: tier 2 stacks to 1 per row so long names breathe. */
  @media (max-width: 420px) {
    .lineup__band--2 { flex: 0 0 100%; }
  }
</style>
