---
import data from '../data/partners.json';
const emph = data.headline_emphasis;
const parts = emph && data.headline.includes(emph) ? data.headline.split(emph) : [data.headline];
---
<section id="partners" class="partners">
  <div class="container">
    <header class="partners__head">
      <span class="eyebrow">{data.eyebrow}</span>
      <h2 class="display partners__title">
        {parts.length > 1 ? (
          <>{parts[0]}<br/><span class="editorial">{emph}</span>{parts.slice(1).join(emph)}</>
        ) : data.headline}
      </h2>
      <p class="partners__lead">{data.description}</p>
    </header>

    <div class="partners__tiers">
      {data.tiers.map((tier) => (
        <div class="tier">
          <div class="tier__label">
            <span class="mono">{tier.label}</span>
            <span class="tier__rule" aria-hidden="true"></span>
          </div>
          <ul class="tier__grid" data-tier={tier.label.toLowerCase()}>
            {tier.partners.map((p) => (
              <li class="partner">
                <span class="display partner__name">{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    background: var(--ink-soft);
    color: var(--bone);
    position: relative;
  }
  .partners__head {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .partners__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.9;
  }
  .partners__title .editorial {
    color: var(--neon);
    font-style: italic;
  }
  .partners__lead {
    max-width: 54ch;
    color: var(--lavender);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .partners__tiers {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .tier { display: grid; gap: 1.25rem; }
  .tier__label {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    color: var(--lavender);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
  }
  .tier__rule {
    height: 1px;
    background: color-mix(in oklab, var(--bone) 14%, transparent);
  }

  .tier__grid {
    display: grid;
    gap: 1px;
    background: color-mix(in oklab, var(--bone) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--bone) 10%, transparent);
  }
  .tier__grid[data-tier='presenting']   { grid-template-columns: repeat(2, 1fr); }
  .tier__grid[data-tier='official']     { grid-template-columns: repeat(4, 1fr); }
  .tier__grid[data-tier='community']    { grid-template-columns: repeat(6, 1fr); }

  .partner {
    background: var(--ink-soft);
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: background .35s var(--ease), color .35s var(--ease), transform .35s var(--ease);
  }
  .partner__name {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--bone);
    transition: color .35s var(--ease);
  }

  .tier__grid[data-tier='presenting'] .partner__name { font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .tier__grid[data-tier='official']   .partner__name { font-size: clamp(1.05rem, 1.6vw, 1.35rem); }
  .tier__grid[data-tier='community']  .partner__name {
    font-family: var(--f-mono);
    font-size: clamp(0.7rem, 0.9vw, 0.82rem);
    letter-spacing: 0.16em;
    color: var(--lavender);
  }

  .partner:hover {
    background: var(--neon);
    transform: translateY(-2px);
  }
  .partner:hover .partner__name { color: var(--ink); }

  @media (max-width: 900px) {
    .tier__grid[data-tier='presenting']  { grid-template-columns: 1fr; }
    .tier__grid[data-tier='official']    { grid-template-columns: repeat(2, 1fr); }
    .tier__grid[data-tier='community']   { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .partners__lead { font-size: 0.95rem; }
    .partner { padding: 1rem 0.5rem; }
    .tier { gap: 0.85rem; }
    .tier__grid[data-tier='presenting']  { grid-template-columns: 1fr; }
    .tier__grid[data-tier='official']    { grid-template-columns: repeat(2, 1fr); }
    .tier__grid[data-tier='community']   { grid-template-columns: repeat(2, 1fr); }
    .tier__grid[data-tier='presenting'] .partner__name { font-size: 1.3rem; }
    .tier__grid[data-tier='official'] .partner__name   { font-size: 0.88rem; }
    .tier__grid[data-tier='community'] .partner__name  { font-size: 0.62rem; letter-spacing: 0.12em; }
  }
</style>
